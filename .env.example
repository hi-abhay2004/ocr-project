# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=evalsys
POSTGRES_USER=evalsys
POSTGRES_PASSWORD=evalsys
DATABASE_URL=postgres://evalsys:evalsys@localhost:5432/evalsys

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# NVIDIA NIM — https://build.nvidia.com, OpenAI-compatible endpoint.
# Leave blank to force LLM_PROVIDER=mock; nothing in the app requires this key.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
NIM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# base | nim | ollama — see ai/providers/. mock is used automatically under pytest.
LLM_PROVIDER=mock

CORS_ALLOWED_ORIGINS=http://localhost:5173
